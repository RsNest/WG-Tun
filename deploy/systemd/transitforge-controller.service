[Unit]
Description=transitforge controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=transitforge
Group=transitforge
ExecStart=/usr/local/bin/transitforge-controller --config /etc/transitforge/controller.yaml
Restart=on-failure
RestartSec=3
AmbientCapabilities=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/transitforge /etc/transitforge /var/lib/transitforge/certs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
